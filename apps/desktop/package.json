{
  "name": "@arbora/desktop",
  "productName": "Arbora",
  "desktopName": "arbora.desktop",
  "version": "0.0.1",
  "description": "Design Mode for Agents",
  "author": {
    "name": "Arbora",
    "email": "hello@arbora.dev"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/fetch-devtools-extensions.mjs --optional && electron-vite dev -- --class=arbora",
    "build": "electron-vite build",
    "build:test": "electron-vite build --mode test",
    "preview": "electron-vite preview",
    "e2e": "node scripts/fetch-devtools-extensions.mjs --optional && pnpm build:test && playwright test",
    "package": "node scripts/fetch-devtools-extensions.mjs && electron-vite build && electron-builder --publish never",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "extensions": "node scripts/fetch-devtools-extensions.mjs",
    "extensions:update": "node scripts/fetch-devtools-extensions.mjs --update"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@arbora/shared": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fflate": "0.8.3",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "zustand": "5.0.16"
  },
  "homepage": "https://github.com/maplepreneur/arbora"
}
