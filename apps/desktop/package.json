{
  "name": "@arbora/desktop",
  "productName": "Arbora",
  "desktopName": "arbora.desktop",
  "version": "0.0.4",
  "description": "Design Mode for Agents",
  "author": {
    "name": "Arbora",
    "email": "hello@arbora.dev"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/fetch-devtools-extensions.mjs --optional && electron-vite dev -- --class=arbora",
    "build": "electron-vite build",
    "build:test": "electron-vite build --mode test",
    "preview": "electron-vite preview",
    "e2e": "node scripts/fetch-devtools-extensions.mjs --optional && pnpm build:test && playwright test",
    "package": "node scripts/fetch-devtools-extensions.mjs && electron-vite build && electron-builder --publish never",
    "postinstall": "install-electron && electron-builder install-app-deps && node scripts/fix-node-pty.mjs",
    "extensions": "node scripts/fetch-devtools-extensions.mjs",
    "extensions:update": "node scripts/fetch-devtools-extensions.mjs --update",
    "perf": "ARBORA_PERF=1 playwright test e2e/perf.spec.ts",
    "release": "node scripts/fetch-devtools-extensions.mjs && electron-vite build && electron-builder --publish always"
  },
  "dependencies": {
    "chokidar": "6.0.0",
    "electron-updater": "6.8.11",
    "fflate": "0.8.3",
    "ignore": "7.0.14",
    "node-pty": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@arbora/acp-client": "workspace:*",
    "@arbora/browser-bridge": "workspace:*",
    "@arbora/mcp-browser-server": "workspace:*",
    "@arbora/shared": "workspace:*",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-vue": "0.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.1",
    "@replit/codemirror-lang-svelte": "6.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "diff": "9.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "highlight.js": "11.12.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.15.3",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "zustand": "5.0.16"
  },
  "homepage": "https://github.com/maplepreneur/arbora"
}
